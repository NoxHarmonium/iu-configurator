# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Dev compose — HA runtime state (DB, logs, .storage) lives in a named Docker
# volume, but if it ever gets written to the worktree, ignore it.
dev/ha/runtime/
dev/config